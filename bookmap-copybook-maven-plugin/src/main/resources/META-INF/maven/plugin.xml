<?xml version="1.0" encoding="UTF-8"?>
<!-- The descriptor of bookmap-copybook-maven-plugin. It is written by hand.
     PluginDescriptorTest compares it with the fields of GenerateMojo.
     The build replaces the token of the version. -->
<plugin>
  <name>BookMap copybook Maven plugin</name>
  <description>Generates BookMap classes from COBOL copybooks.</description>
  <groupId>pt.dazz.bookmap</groupId>
  <artifactId>bookmap-copybook-maven-plugin</artifactId>
  <version>@pluginVersion@</version>
  <goalPrefix>bookmap-copybook</goalPrefix>
  <isolatedRealm>false</isolatedRealm>
  <inheritedByDefault>true</inheritedByDefault>
  <requiredJavaVersion>21</requiredJavaVersion>
  <requiredMavenVersion>3.6.3</requiredMavenVersion>
  <mojos>
    <mojo>
      <goal>generate</goal>
      <description>Generates the BookMap classes from the COBOL copybooks in a directory tree, and adds the generated sources to the compile source roots of the project.</description>
      <requiresDirectInvocation>false</requiresDirectInvocation>
      <requiresProject>true</requiresProject>
      <requiresReports>false</requiresReports>
      <aggregator>false</aggregator>
      <requiresOnline>false</requiresOnline>
      <inheritedByDefault>true</inheritedByDefault>
      <phase>generate-sources</phase>
      <implementation>pt.dazz.bookmap.copybook.maven.GenerateMojo</implementation>
      <language>java</language>
      <instantiationStrategy>per-lookup</instantiationStrategy>
      <executionStrategy>once-per-session</executionStrategy>
      <threadSafe>true</threadSafe>
      <parameters>
        <parameter>
          <name>project</name>
          <type>org.apache.maven.project.MavenProject</type>
          <required>true</required>
          <editable>false</editable>
          <description>The Maven project.</description>
        </parameter>
        <parameter>
          <name>sourceDir</name>
          <type>java.io.File</type>
          <required>false</required>
          <editable>true</editable>
          <description>The root of the copybook tree. The goal scans it recursively.</description>
        </parameter>
        <parameter>
          <name>copyDirs</name>
          <type>java.util.List</type>
          <required>false</required>
          <editable>true</editable>
          <description>The directories with the COPY members, in search order. The search in each directory is not recursive.</description>
        </parameter>
        <parameter>
          <name>packageName</name>
          <type>java.lang.String</type>
          <required>false</required>
          <editable>true</editable>
          <description>The base package. The directories below the source directory give the subpackages.</description>
        </parameter>
        <parameter>
          <name>lombok</name>
          <type>boolean</type>
          <required>false</required>
          <editable>true</editable>
          <description>Generate Lombok classes.</description>
        </parameter>
        <parameter>
          <name>packagePerCopybook</name>
          <type>boolean</type>
          <required>false</required>
          <editable>true</editable>
          <description>Add one package segment from the copybook name.</description>
        </parameter>
        <parameter>
          <name>maxRecordLength</name>
          <type>java.lang.Integer</type>
          <required>false</required>
          <editable>true</editable>
          <description>The maximum record length in bytes. A longer record gives a warning.</description>
        </parameter>
        <parameter>
          <name>outputDir</name>
          <type>java.io.File</type>
          <required>false</required>
          <editable>true</editable>
          <description>The directory for the generated Java files.</description>
        </parameter>
        <parameter>
          <name>includes</name>
          <type>java.util.List</type>
          <required>false</required>
          <editable>true</editable>
          <description>The include patterns of the copybook files, relative to the source directory. The default is **/*.cpy.</description>
        </parameter>
        <parameter>
          <name>excludes</name>
          <type>java.util.List</type>
          <required>false</required>
          <editable>true</editable>
          <description>The exclude patterns of the files in the source directory that are not copybooks.</description>
        </parameter>
        <parameter>
          <name>skip</name>
          <type>boolean</type>
          <required>false</required>
          <editable>true</editable>
          <description>Do not generate the classes. The goal still adds the output directory as a source root.</description>
        </parameter>
        <parameter>
          <name>buildDirectory</name>
          <type>java.io.File</type>
          <required>false</required>
          <editable>false</editable>
          <description>The build directory of the project. The goal stores the fingerprint below it.</description>
        </parameter>
        <parameter>
          <name>pluginVersion</name>
          <type>java.lang.String</type>
          <required>false</required>
          <editable>false</editable>
          <description>The version of this plugin. It is part of the fingerprint.</description>
        </parameter>
      </parameters>
      <configuration>
        <project implementation="org.apache.maven.project.MavenProject">${project}</project>
        <sourceDir implementation="java.io.File" default-value="${project.basedir}/src/main/copybook">${bookmap.copybook.sourceDir}</sourceDir>
        <packageName implementation="java.lang.String">${bookmap.copybook.packageName}</packageName>
        <lombok implementation="boolean" default-value="false">${bookmap.copybook.lombok}</lombok>
        <packagePerCopybook implementation="boolean" default-value="false">${bookmap.copybook.packagePerCopybook}</packagePerCopybook>
        <maxRecordLength implementation="java.lang.Integer">${bookmap.copybook.maxRecordLength}</maxRecordLength>
        <outputDir implementation="java.io.File" default-value="${project.build.directory}/generated-sources/copybook">${bookmap.copybook.outputDir}</outputDir>
        <skip implementation="boolean" default-value="false">${bookmap.copybook.skip}</skip>
        <buildDirectory implementation="java.io.File">${project.build.directory}</buildDirectory>
        <pluginVersion implementation="java.lang.String">${plugin.version}</pluginVersion>
      </configuration>
    </mojo>
  </mojos>
  <dependencies/>
</plugin>
